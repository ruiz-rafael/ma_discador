{
  "openapi": "3.0.3",
  "info": {
    "title": "DiscAI Gmail provider dependency",
    "version": "1.1.0",
    "description": "Narrow outbound dependency. Local simulation: tests/Fixtures/google-mail-http.php. Production hosts are fixed in GoogleMail; test_base only in APP_ENV=testing."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:19134",
      "description": "Disposable loopback fixture only"
    }
  ],
  "paths": {
    "/token": {
      "post": {
        "operationId": "token",
        "responses": {
          "200": {
            "description": "Provider success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "refresh_token": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "integer"
                    },
                    "scope": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid grant or request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Reconnect required"
          },
          "429": {
            "description": "Provider limit"
          },
          "503": {
            "description": "Unavailable; no automatic resend"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": [
                      "authorization_code",
                      "refresh_token"
                    ]
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "client_secret": {
                    "type": "string",
                    "writeOnly": true
                  },
                  "code": {
                    "type": "string"
                  },
                  "code_verifier": {
                    "type": "string"
                  },
                  "redirect_uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "refresh_token": {
                    "type": "string",
                    "writeOnly": true
                  }
                },
                "required": [
                  "grant_type",
                  "client_id",
                  "client_secret"
                ]
              }
            }
          }
        }
      }
    },
    "/userinfo": {
      "get": {
        "operationId": "userinfo",
        "responses": {
          "200": {
            "description": "Provider success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sub": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "email_verified": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid grant or request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Reconnect required"
          },
          "429": {
            "description": "Provider limit"
          },
          "503": {
            "description": "Unavailable; no automatic resend"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/send": {
      "post": {
        "operationId": "send",
        "responses": {
          "200": {
            "description": "Provider success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid grant or request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Reconnect required"
          },
          "429": {
            "description": "Provider limit"
          },
          "503": {
            "description": "Unavailable; no automatic resend"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "raw": {
                    "type": "string",
                    "description": "Base64url RFC 2822 MIME"
                  }
                },
                "required": [
                  "raw"
                ]
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/senders": {
      "get": {
        "operationId": "sendAsList",
        "description": "Production GET /gmail/v1/users/me/settings/sendAs. Requires optional gmail.settings.basic. Only primary or verificationStatus=accepted identities are offered; SMTP/signature data are discarded.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "sendAs identities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "sendAs"
                  ],
                  "properties": {
                    "sendAs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sendAsEmail": {
                            "type": "string",
                            "format": "email"
                          },
                          "isPrimary": {
                            "type": "boolean"
                          },
                          "verificationStatus": {
                            "type": "string",
                            "enum": [
                              "accepted",
                              "pending"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Reconnect"
          },
          "403": {
            "description": "Missing permission or disabled API; no send"
          },
          "503": {
            "description": "Lookup unavailable; no send"
          },
          "302": {
            "description": "Redirect refused; no send"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
