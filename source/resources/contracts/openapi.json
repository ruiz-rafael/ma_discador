            "description": "Limite de requisições atingido"
          }
        }
      }
    },
    "/events": {
      "get": {
        "summary": "Eventos com cursor crescente; até 100 por página",
        "security": [
          {
            "integrationToken": []
          }
        ],
        "x-required-scope": "events:read",
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso. Coleções retornam paginação ou cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "next_cursor": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sequence": {
                            "type": "integer"
                          },
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "version": {
                            "type": "integer",
                            "const": 1
                          },
                          "type": {
                            "type": "string"
                          },
                          "subject_id": {
                            "type": "string"
                          },
                          "occurred_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "data": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "required": [],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "next_cursor",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente, revogada ou expirada"
          },
          "403": {
            "description": "Escopo, lista ou atendente não permitido"
          },
          "409": {
            "description": "Conflito de idempotência ou revisão"
          },
          "422": {
            "description": "Dados inválidos; nenhuma importação parcial"
          },
          "429": {
            "description": "Limite de requisições atingido"
          }
        }
      }
    },
    "/embed-sessions": {
      "post": {
        "summary": "Sessão temporária de 10 minutos para um atendente permitido; não inicia chamadas",
        "security": [
          {
            "integrationToken": []
          }
        ],
        "x-required-scope": "voice:embed",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Sucesso. Coleções retornam paginação ou cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "integer",
                      "const": 600
                    },
                    "origin": {
                      "type": "string"
                    },
                    "iframe_url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "access_token",
