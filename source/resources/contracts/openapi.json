  "paths": {
    "/lists": {
      "get": {
        "summary": "Listas explicitamente permitidas, com esquema de campos",
        "security": [
          {
            "integrationToken": []
          }
        ],
        "x-required-scope": "lists:read",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Sucesso. Coleções retornam paginação ou cursor."
          },
          "401": {
            "description": "Credencial ausente, revogada ou expirada"
          },
          "403": {
            "description": "Escopo, lista ou atendente não permitido"
          },
          "409": {
            "description": "Conflito de idempotência ou revisão"
          },
          "422": {
            "description": "Dados inválidos; nenhuma importação parcial"
          },
          "429": {
            "description": "Limite de requisições atingido"
          }
        }
      }
    },
    "/contacts/import": {
      "post": {
        "summary": "Inclusão incremental de até 100 contatos; preserva exclusões e autorização existente",
        "security": [
          {
            "integrationToken": []
          }
        ],
        "x-required-scope": "lists:write",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Repetir o mesmo UUID e corpo retorna o resultado original. Outro corpo com o mesmo UUID retorna 409."
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso. Coleções retornam paginação ou cursor."
          },
          "401": {
            "description": "Credencial ausente, revogada ou expirada"
          },
          "403": {
            "description": "Escopo, lista ou atendente não permitido"
          },
          "409": {
            "description": "Conflito de idempotência ou revisão"
          },
          "422": {
            "description": "Dados inválidos; nenhuma importação parcial"
          },
          "429": {
            "description": "Limite de requisições atingido"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "automation",
                      "voice"
                    ]
                  },
                  "list_id": {
                    "type": "integer"
                  },
                  "contacts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "phone": {
                          "type": "string",
                          "description": "E.164 recomendado; DDI e DDD obrigatórios"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "source": {
                          "type": "string"
                        },
                        "crm_contact_id": {
                          "type": "string"
                        },
                        "consent": {
                          "type": "boolean"
                        },
                        "consent_evidence": {
                          "type": "string"
                        },
                        "fields": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      },
                      "required": [
                        "name",
                        "consent"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 100
                  }
                },
                "required": [
                  "kind",
                  "list_id",
                  "contacts"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/calls": {
      "get": {
        "summary": "Histórico de chamadas de saída, resultado técnico e tabulação",
        "security": [
          {
            "integrationToken": []
          }
        ],
        "x-required-scope": "calls:read",
        "parameters": [
